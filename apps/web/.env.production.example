# ============================================================
# Web (customer) — Production environment template
# ============================================================
# Set these in Vercel's project Environment Variables (Production scope).
# REMEMBER: NEXT_PUBLIC_* values are baked into the build — change them
# means trigger a redeploy.

# Public origin where this app is served. Used for canonical URLs,
# Open Graph image absolute paths, and sitemap.
NEXT_PUBLIC_APP_URL=https://pizza-height.vercel.app

# API origin (Railway / Render / Fly URL). Must include /api/v1.
NEXT_PUBLIC_API_URL=https://pizza-height-api.up.railway.app/api/v1

# Socket.io URL — the API origin without /api/v1.
NEXT_PUBLIC_WS_URL=https://pizza-height-api.up.railway.app

# Cloudinary (optional, only if Upload module is exercised)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
