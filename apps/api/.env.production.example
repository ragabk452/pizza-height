# ============================================================
# API — Production environment template
# ============================================================
# Set in Railway / Render service Variables. The API fails fast at boot
# if any of JWT_SECRET, JWT_REFRESH_SECRET, or DATABASE_URL is missing
# in production (see apps/api/src/config/configuration.ts).

NODE_ENV=production
PORT=4000

# Comma-separated list of frontend origins allowed to call this API.
# Include BOTH web + admin Vercel URLs (and any custom domains).
CORS_ORIGINS=https://pizza-height.vercel.app,https://admin-pizza-height.vercel.app

# Postgres connection string — Railway / Render provide this automatically
# when you attach a Postgres service. Format:
#   postgresql://USER:PASS@HOST:5432/DB?schema=public
DATABASE_URL=

# Redis URL — Railway / Render provide this when you attach Redis.
REDIS_URL=

# JWT secrets — MUST be set in production, MUST be long random strings.
# Generate one with:  openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# Cloudinary (optional — Upload module no-ops without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paymob (optional — leave blank to use the mock provider in production
# for portfolio demos).
# When all four are set with real values, the real PaymobClient activates
# automatically. See HANDOFF.md §7 caveat 10 for the placeholder pattern.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Where the mock-mode payment page lives — should equal NEXT_PUBLIC_APP_URL
# of the web service.
PAYMOB_MOCK_BASE_URL=https://pizza-height.vercel.app

# Throttler — defaults are fine but tunable per environment.
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100
