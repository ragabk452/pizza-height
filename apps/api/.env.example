# =================================================================
# Pizza Height - API Backend Environment Variables
# =================================================================

# Application
NODE_ENV=development
PORT=4000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://pizza_admin:pizza_secret@localhost:5432/pizza_height?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — REQUIRED in production. The app refuses to boot if these are unset
# when NODE_ENV=production. Generate with: `openssl rand -base64 64`.
JWT_SECRET=replace_me_with_a_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string_at_least_64_chars
JWT_REFRESH_EXPIRY=7d

# Cloudinary (image storage — free tier). Leave blank to no-op uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

