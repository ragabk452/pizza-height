# =================================================================
# Pizza Height - API Backend Environment Variables
# =================================================================

# Application
NODE_ENV=development
PORT=4000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://pizza_admin:pizza_secret@localhost:5432/pizza_height?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — REQUIRED in production. The app refuses to boot if these are unset
# when NODE_ENV=production. Generate with: `openssl rand -base64 64`.
JWT_SECRET=replace_me_with_a_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string_at_least_64_chars
JWT_REFRESH_EXPIRY=7d

# Cloudinary (image storage — free tier). Leave blank to no-op uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paymob Sandbox (Egyptian payment gateway, test mode). Leave ANY value
# blank and the API uses the in-process MockPaymobClient — the full CARD
# flow still works end-to-end against the web app's /payment/mock page,
# but no third-party HTTP is made. Fill all four to switch to real Paymob.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# Where the mock iframe URL points. Defaults to http://localhost:3000.
PAYMOB_MOCK_BASE_URL=http://localhost:3000

# ===== Planned (not yet wired up) =====
# Sprint 8 will add Resend (transactional email):
#   RESEND_API_KEY=
#   EMAIL_FROM=
