# =================================================================
# Pizza Height - API Backend Environment Variables
# =================================================================

# Application
NODE_ENV=development
PORT=4000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://pizza_admin:pizza_secret@localhost:5432/pizza_height?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace_me_with_a_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string_at_least_64_chars
JWT_REFRESH_EXPIRY=7d

# Cloudinary (image storage - free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paymob Sandbox (Egyptian payment gateway - test mode)
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret

# Resend (email - free tier: 100/day)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=onboarding@resend.dev
